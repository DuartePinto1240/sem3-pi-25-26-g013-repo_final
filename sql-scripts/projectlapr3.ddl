CREATE TABLE RailwayLine (line_id number(10) GENERATED AS IDENTITY, gauge_id number(10) NOT NULL, owner_id number(10) NOT NULL, start_station_id number(10) NOT NULL, end_station_id number(10) NOT NULL, name nvarchar2(255) NOT NULL, PRIMARY KEY (line_id));
CREATE TABLE LineSegment (line_segment_id number(10) GENERATED AS IDENTITY, line_id number(10) NOT NULL, length_m number(10) NOT NULL, speed_limit number(10) NOT NULL, max_weight nvarchar2(255) NOT NULL, segment_order number(5) NOT NULL, track_type varchar2(6) NOT NULL, electrified varchar2(3) NOT NULL, PRIMARY KEY (line_segment_id), CONSTRAINT CHK_is_eletcrified CHECK (electrified IN ('Y'es, 'No') ), CONSTRAINT " CHK_track_type_valid" CHECK (track_type IN ('single', 'double') ));
CREATE TABLE Locomotive (loco_id number(10) GENERATED AS IDENTITY, fueltype_id number(10) NOT NULL, gauge_id number(10) NOT NULL, operator_id number(10) NOT NULL, name varchar2(10) NOT NULL, model nvarchar2(255) NOT NULL, fluel_capacity number(10), "power _kn" number(10) NOT NULL, weight number(10) NOT NULL, make varchar2(255) NOT NULL, service_year number(4) NOT NULL, voltage_kv number(10) NOT NULL, frequency_hz number(10) NOT NULL, PRIMARY KEY (loco_id));
CREATE TABLE Wagon (wagon_id number(10) GENERATED AS IDENTITY, operator_id number(10) NOT NULL, wagonmodel_id number(10) NOT NULL, service_year number(4) NOT NULL, PRIMARY KEY (wagon_id));
CREATE TABLE Station (station_id number(10) GENERATED AS IDENTITY, facility_id number(10) NOT NULL, PRIMARY KEY (station_id));
CREATE TABLE Freight (freight_id number(10) GENERATED AS IDENTITY, origin_station_id number(10) NOT NULL, destination_station_id number(10) NOT NULL, train_id number(10) NOT NULL, departure_time date NOT NULL, arrival_time date NOT NULL, PRIMARY KEY (freight_id));
CREATE TABLE Terminal (terminal_id number(10) GENERATED AS IDENTITY, facility_id number(10) NOT NULL, capacity number(10) NOT NULL, PRIMARY KEY (terminal_id), CONSTRAINT CHK_Capacity_Bigger_Than_Zero CHECK (capacity > 0));
CREATE TABLE Operator (operator_id number(10) GENERATED AS IDENTITY, name varchar2(255) NOT NULL, country nvarchar2(255) NOT NULL, vat_number varchar2(255) NOT NULL, short_name varchar2(255) NOT NULL, PRIMARY KEY (operator_id));
CREATE TABLE Facility (facility_id number(10) GENERATED AS IDENTITY, address_id number(10) NOT NULL, type nvarchar2(255) NOT NULL, name nvarchar2(255) NOT NULL, PRIMARY KEY (facility_id));
CREATE TABLE FreightYard (freightyard_id number(10) GENERATED AS IDENTITY, facility_id number(10) NOT NULL, PRIMARY KEY (freightyard_id));
CREATE TABLE Train (train_id number(10) GENERATED AS IDENTITY, name number(10) NOT NULL, PRIMARY KEY (train_id));
CREATE TABLE WagonType (wagontype_id number(10) GENERATED AS IDENTITY, type varchar2(255) NOT NULL UNIQUE, PRIMARY KEY (wagontype_id), CONSTRAINT UQ_wagontype_type UNIQUE (type));
CREATE TABLE FuelType (fueltype_id number(10) GENERATED AS IDENTITY, type varchar2(8) NOT NULL, PRIMARY KEY (fueltype_id), CONSTRAINT "CHK_fueltype_valid " CHECK (type IN ('Diesel', 'Electric') ));
CREATE TABLE Gauge (gauge_id number(10) GENERATED AS IDENTITY, width_mm number(10) NOT NULL UNIQUE, description nvarchar2(255) NOT NULL, PRIMARY KEY (gauge_id), CONSTRAINT UQ_gauge_width UNIQUE (width_mm));
CREATE TABLE Cargo (cargo_id number(10) GENERATED AS IDENTITY, wagon_id number(10) NOT NULL, description nvarchar2(255) NOT NULL, type nvarchar2(255) NOT NULL, quantity number(10) NOT NULL, volume number(10) NOT NULL, weight number(10) NOT NULL, expiry_date date NOT NULL, PRIMARY KEY (cargo_id));
CREATE TABLE Address (address_id number(10) GENERATED AS IDENTITY, postalCode_id number(10) NOT NULL, doorNumber number(10) NOT NULL, PRIMARY KEY (address_id));
CREATE TABLE PostalCode (postalCode_id number(10) GENERATED AS IDENTITY, street nvarchar2(255) NOT NULL, city nvarchar2(255) NOT NULL, country nvarchar2(255) NOT NULL, PRIMARY KEY (postalCode_id));
CREATE TABLE TrainLocomotive (train_id number(10) NOT NULL, loco_id number(10) NOT NULL, PRIMARY KEY (train_id, loco_id));
CREATE TABLE TrainWagon (train_id number(10) NOT NULL, wagon_id number(10) NOT NULL, PRIMARY KEY (train_id, wagon_id));
CREATE TABLE Owner (owner_id number(10) GENERATED AS IDENTITY, name varchar2(10) NOT NULL, short_name varchar2(10) NOT NULL, vat_number varchar2(255) NOT NULL, PRIMARY KEY (owner_id));
CREATE TABLE WagonModel (wagonmodel_id number(10) GENERATED AS IDENTITY, wagontype_id number(10) NOT NULL, gauge_id number(10) NOT NULL, manufacturer varchar2(255) NOT NULL, name varchar2(255) NOT NULL UNIQUE, axles number(2) NOT NULL, decks number(2) NOT NULL, length_m number(10) NOT NULL, tare_t number(10) NOT NULL, payload_t number(10) NOT NULL, max_speed_loaded_kmh number(10) NOT NULL, max_speed_empty_kmh number(10) NOT NULL, PRIMARY KEY (wagonmodel_id), CONSTRAINT "UNIQUE (name) " UNIQUE (name));
ALTER TABLE LineSegment ADD CONSTRAINT FKLineSegmen69130 FOREIGN KEY (line_id) REFERENCES RailwayLine (line_id);
ALTER TABLE Locomotive ADD CONSTRAINT FKLocomotive800157 FOREIGN KEY (fueltype_id) REFERENCES FuelType (fueltype_id);
ALTER TABLE Station ADD CONSTRAINT FKStation165098 FOREIGN KEY (facility_id) REFERENCES Facility (facility_id);
ALTER TABLE FreightYard ADD CONSTRAINT FKFreightYar132355 FOREIGN KEY (facility_id) REFERENCES Facility (facility_id);
ALTER TABLE Terminal ADD CONSTRAINT FKTerminal288214 FOREIGN KEY (facility_id) REFERENCES Facility (facility_id);
ALTER TABLE Freight ADD CONSTRAINT origin FOREIGN KEY (origin_station_id) REFERENCES Station (station_id);
ALTER TABLE Cargo ADD CONSTRAINT FKCargo674680 FOREIGN KEY (wagon_id) REFERENCES Wagon (wagon_id);
ALTER TABLE Locomotive ADD CONSTRAINT FKLocomotive253262 FOREIGN KEY (gauge_id) REFERENCES Gauge (gauge_id);
ALTER TABLE Address ADD CONSTRAINT FKAddress918730 FOREIGN KEY (postalCode_id) REFERENCES PostalCode (postalCode_id);
ALTER TABLE Facility ADD CONSTRAINT FKFacility135279 FOREIGN KEY (address_id) REFERENCES Address (address_id);
ALTER TABLE TrainLocomotive ADD CONSTRAINT FKTrainLocom412768 FOREIGN KEY (train_id) REFERENCES Train (train_id);
ALTER TABLE TrainLocomotive ADD CONSTRAINT FKTrainLocom665563 FOREIGN KEY (loco_id) REFERENCES Locomotive (loco_id);
ALTER TABLE TrainWagon ADD CONSTRAINT FKTrainWagon263455 FOREIGN KEY (train_id) REFERENCES Train (train_id);
ALTER TABLE TrainWagon ADD CONSTRAINT FKTrainWagon214126 FOREIGN KEY (wagon_id) REFERENCES Wagon (wagon_id);
ALTER TABLE Freight ADD CONSTRAINT destination FOREIGN KEY (destination_station_id) REFERENCES Station (station_id);
ALTER TABLE Freight ADD CONSTRAINT "performed by" FOREIGN KEY (train_id) REFERENCES Train (train_id);
ALTER TABLE Locomotive ADD CONSTRAINT FKLocomotive501990 FOREIGN KEY (operator_id) REFERENCES Operator (operator_id);
ALTER TABLE Wagon ADD CONSTRAINT FKWagon928453 FOREIGN KEY (operator_id) REFERENCES Operator (operator_id);
ALTER TABLE RailwayLine ADD CONSTRAINT FKRailwayLin461619 FOREIGN KEY (owner_id) REFERENCES Owner (owner_id);
ALTER TABLE Wagon ADD CONSTRAINT FKWagon919383 FOREIGN KEY (wagonmodel_id) REFERENCES WagonModel (wagonmodel_id);
ALTER TABLE WagonModel ADD CONSTRAINT FKWagonModel467548 FOREIGN KEY (wagontype_id) REFERENCES WagonType (wagontype_id);
ALTER TABLE WagonModel ADD CONSTRAINT FKWagonModel993863 FOREIGN KEY (gauge_id) REFERENCES Gauge (gauge_id);
ALTER TABLE RailwayLine ADD CONSTRAINT FKRailwayLin580810 FOREIGN KEY (gauge_id) REFERENCES Gauge (gauge_id);
ALTER TABLE RailwayLine ADD CONSTRAINT "start at" FOREIGN KEY (start_station_id) REFERENCES Station (station_id);
ALTER TABLE RailwayLine ADD CONSTRAINT FKRailwayLin516717 FOREIGN KEY (end_station_id) REFERENCES Station (station_id);
