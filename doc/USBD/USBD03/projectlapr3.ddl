CREATE TABLE RailwayLine
(
    line_id          NUMBER(10) GENERATED AS IDENTITY,
    gauge_id         NUMBER(10)     NOT NULL,
    owner_id         NUMBER(10)     NOT NULL,
    start_station_id NUMBER(10)     NOT NULL,
    end_station_id   NUMBER(10)     NOT NULL,
    name             NVARCHAR2(255) NOT NULL UNIQUE,
    CONSTRAINT PK_RailwayLine PRIMARY KEY (line_id)
);

CREATE TABLE LineSegment
(
    line_segment_id NUMBER(10) GENERATED BY DEFAULT ON NULL AS IDENTITY,
    line_id         NUMBER(10)   NOT NULL,
    segment_order   NUMBER(5)    NOT NULL,
    length_m        NUMBER(10,2) NOT NULL,
    speed_limit     NUMBER(10,2) NOT NULL,
    max_weight      NUMBER(10,2) NOT NULL,
    track_type      VARCHAR2(6)  NOT NULL,
    electrified     VARCHAR2(3)  NOT NULL,
    CONSTRAINT PK_LineSegment PRIMARY KEY (line_segment_id),
    CONSTRAINT CHK_LineSegment_Order_GT0     CHECK (segment_order > 0),
    CONSTRAINT CHK_LineSegment_Length_GT0    CHECK (length_m > 0),
    CONSTRAINT CHK_LineSegment_MaxWeight_GT0 CHECK (max_weight > 0),
    CONSTRAINT CHK_LineSegment_Speed_GT0     CHECK (speed_limit > 0),
    CONSTRAINT CHK_LineSegment_TrackType     CHECK (track_type IN ('single','double')),
    CONSTRAINT CHK_LineSegment_Electrified   CHECK (electrified IN ('Yes','No'))
);

CREATE TABLE Locomotive
(
    loco_id               NUMBER(10) GENERATED BY DEFAULT ON NULL AS IDENTITY,
    gauge_id              NUMBER(10)     NOT NULL,
    operator_id           NUMBER(10)     NOT NULL,
    name                  VARCHAR2(30)   NOT NULL,
    make                  VARCHAR2(255)  NOT NULL,
    model                 NVARCHAR2(255) NOT NULL,
    power_kw              NUMBER(7,2)    NOT NULL,
    weight_t              NUMBER(7,3)    NOT NULL,
    service_year          NUMBER(4)      NOT NULL,
    height_m              NUMBER(7,3)    NOT NULL,
    width_m               NUMBER(7,3)    NOT NULL,
    length_m              NUMBER(7,3)    NOT NULL,
    max_speed_kmh         NUMBER(5,2)    NOT NULL,
    operational_speed_kmh NUMBER(5,2)    NOT NULL,
    traction_kn           NUMBER(10,2)   NOT NULL,
    number_of_bogies      NUMBER(10)     NOT NULL,
    bogies                VARCHAR2(255)  NOT NULL,
    CONSTRAINT PK_Locomotive PRIMARY KEY (loco_id),
    CONSTRAINT CHK_Loco_power_GT0        CHECK (power_kw > 0),
    CONSTRAINT CHK_Loco_weight_GT0       CHECK (weight_t > 0),
    CONSTRAINT CHK_Loco_height_GT0       CHECK (height_m > 0),
    CONSTRAINT CHK_Loco_width_GT0        CHECK (width_m > 0),
    CONSTRAINT CHK_Loco_length_GT0       CHECK (length_m > 0),
    CONSTRAINT CHK_Loco_Speeds           CHECK (max_speed_kmh > 0 AND operational_speed_kmh > 0 AND operational_speed_kmh <= max_speed_kmh),
    CONSTRAINT CHK_Loco_Bogies           CHECK (number_of_bogies >= 1)
);

CREATE TABLE Wagon
(
    wagon_id      NUMBER(10) GENERATED BY DEFAULT ON NULL AS IDENTITY,
    operator_id   NUMBER(10) NOT NULL,
    wagonmodel_id NUMBER(10) NOT NULL,
    service_year  NUMBER(4)  NOT NULL,
    CONSTRAINT PK_Wagon PRIMARY KEY (wagon_id)
);

CREATE TABLE Facility
(
    facility_id     NUMBER(10) GENERATED AS IDENTITY,
    name            NVARCHAR2(255) NOT NULL UNIQUE,
    location        VARCHAR2(255)  NOT NULL,
    facilitytype_id NUMBER(10)     NOT NULL,
    CONSTRAINT PK_Facility PRIMARY KEY (facility_id)
);

CREATE TABLE Freight
(
    freight_id             NUMBER(10) GENERATED AS IDENTITY,
    origin_station_id      NUMBER(10) NOT NULL,
    destination_station_id NUMBER(10) NOT NULL,
    train_id               NUMBER(10) NOT NULL,
    departure_time         DATE       NOT NULL,
    arrival_time           DATE       NOT NULL,
    CONSTRAINT PK_Freight PRIMARY KEY (freight_id)
);

CREATE TABLE Operator
(
    operator_id NUMBER(10) GENERATED AS IDENTITY,
    name        VARCHAR2(255)  NOT NULL,
    country     NVARCHAR2(255) NOT NULL,
    vat_number  VARCHAR2(255)  NOT NULL UNIQUE,
    short_name  VARCHAR2(255)  NOT NULL,
    CONSTRAINT PK_Operator PRIMARY KEY (operator_id)
);

CREATE TABLE Train
(
    train_id NUMBER(10) GENERATED AS IDENTITY,
    name     VARCHAR2(40) NOT NULL,
    CONSTRAINT PK_Train PRIMARY KEY (train_id)
);

CREATE TABLE WagonType
(
    wagontype_id NUMBER(10) GENERATED AS IDENTITY,
    type         VARCHAR2(255) NOT NULL,
    CONSTRAINT PK_WagonType PRIMARY KEY (wagontype_id)
);

CREATE TABLE Gauge
(
    gauge_id    NUMBER(10) GENERATED AS IDENTITY,
    width_mm    NUMBER(10)     NOT NULL UNIQUE,
    description NVARCHAR2(255) NOT NULL,
    CONSTRAINT PK_Gauge PRIMARY KEY (gauge_id)
);

CREATE TABLE Cargo
(
    cargo_id    NUMBER(10) GENERATED AS IDENTITY,
    wagon_id    NUMBER(10)     NOT NULL,
    description NVARCHAR2(255) NOT NULL,
    type        NVARCHAR2(255) NOT NULL,
    quantity    NUMBER(10)     NOT NULL,
    volume      NUMBER(10,2)   NOT NULL,
    weight      NUMBER(10,2)   NOT NULL,
    expiry_date DATE           NOT NULL,
    CONSTRAINT PK_Cargo PRIMARY KEY (cargo_id),
    CONSTRAINT CHK_Cargo_quantity_GT0  CHECK (quantity > 0),
    CONSTRAINT CHK_Cargo_volume_GT0    CHECK (volume > 0),
    CONSTRAINT CHK_Cargo_weight_GT0    CHECK (weight > 0)
);

CREATE TABLE TrainLocomotive
(
    train_id NUMBER(10) NOT NULL,
    loco_id  NUMBER(10) NOT NULL,
    CONSTRAINT PK_TrainLocomotive PRIMARY KEY (train_id, loco_id)
);

CREATE TABLE TrainWagon
(
    train_id NUMBER(10) NOT NULL,
    wagon_id NUMBER(10) NOT NULL,
    CONSTRAINT PK_TrainWagon PRIMARY KEY (train_id, wagon_id)
);

CREATE TABLE Owner
(
    owner_id   NUMBER(10) GENERATED AS IDENTITY,
    name       VARCHAR2(255) NOT NULL,
    short_name VARCHAR2(255) NOT NULL,
    vat_number VARCHAR2(255) NOT NULL UNIQUE,
    CONSTRAINT PK_Owner PRIMARY KEY (owner_id)
);

CREATE TABLE WagonModel
(
    wagonmodel_id    NUMBER(10) GENERATED BY DEFAULT ON NULL AS IDENTITY,
    wagontype_id     NUMBER(10)    NOT NULL,
    gauge_id         NUMBER(10)    NOT NULL,
    name             VARCHAR2(255) NOT NULL UNIQUE,
    maker            VARCHAR2(255) NOT NULL,
    length_mm        NUMBER(10)    NOT NULL,
    weight_t         NUMBER(6,2)   NOT NULL,
    payload_t        NUMBER(6,2)   NOT NULL,
    max_speed_kmh    NUMBER(7,2)   NOT NULL,
    number_of_bogies NUMBER(2)     NOT NULL,
    bogies           VARCHAR2(255) NOT NULL,
    volume_m3        NUMBER(7,2)   NOT NULL,
    height_mm        NUMBER(10)    NOT NULL,
    width_mm         NUMBER(10)    NOT NULL,
    CONSTRAINT PK_WagonModel PRIMARY KEY (wagonmodel_id),
    CONSTRAINT CHK_WagonModel_length_GT0         CHECK (length_mm > 0),
    CONSTRAINT CHK_WagonModel_height_GT0         CHECK (height_mm > 0),
    CONSTRAINT CHK_WagonModel_width_GT0          CHECK (width_mm > 0),
    CONSTRAINT CHK_WagonModel_volume_GT0         CHECK (volume_m3 > 0),
    CONSTRAINT CHK_WagonModel_weight_GT0         CHECK (weight_t > 0),
    CONSTRAINT CHK_WagonModel_payload_GT0        CHECK (payload_t >= 0),
    CONSTRAINT CHK_WagonModel_maxspeed_GT0       CHECK (max_speed_kmh > 0),
    CONSTRAINT CHK_WagonModel_numberofbogies_GT0 CHECK (number_of_bogies >= 1)
);

CREATE TABLE Diesel_Locomotive
(
    loco_id       NUMBER(10)   NOT NULL,
    fuel_capacity NUMBER(10,2) NOT NULL,
    CONSTRAINT PK_Diesel_Locomotive PRIMARY KEY (loco_id)
);

CREATE TABLE Electric_Locomotive
(
    loco_id      NUMBER(10)   NOT NULL,
    voltage_kv   NUMBER(6,2)  NOT NULL,
    frequency_hz NUMBER(6,2)  NOT NULL,
    CONSTRAINT PK_Electric_Locomotive PRIMARY KEY (loco_id)
);

CREATE TABLE FacilityType
(
    facilitytype_id NUMBER(10) GENERATED AS IDENTITY,
    type            VARCHAR2(255) NOT NULL,
    CONSTRAINT PK_FacilityType PRIMARY KEY (facilitytype_id)
);

ALTER TABLE LineSegment
    ADD CONSTRAINT FK_LineSegment_Line
        FOREIGN KEY (line_id) REFERENCES RailwayLine (line_id);

ALTER TABLE Freight
    ADD CONSTRAINT FK_Freight_Origin
        FOREIGN KEY (origin_station_id) REFERENCES Facility (facility_id);

ALTER TABLE Freight
    ADD CONSTRAINT FK_Freight_Destination
        FOREIGN KEY (destination_station_id) REFERENCES Facility (facility_id);

ALTER TABLE Freight
    ADD CONSTRAINT FK_Freight_Train
        FOREIGN KEY (train_id) REFERENCES Train (train_id);

ALTER TABLE Cargo
    ADD CONSTRAINT FK_Cargo_Wagon
        FOREIGN KEY (wagon_id) REFERENCES Wagon (wagon_id);

ALTER TABLE Locomotive
    ADD CONSTRAINT FK_Locomotive_Gauge
        FOREIGN KEY (gauge_id) REFERENCES Gauge (gauge_id);

ALTER TABLE Locomotive
    ADD CONSTRAINT FK_Locomotive_Operator
        FOREIGN KEY (operator_id) REFERENCES Operator (operator_id);

ALTER TABLE TrainLocomotive
    ADD CONSTRAINT FK_TrainLocomotive_Train
        FOREIGN KEY (train_id) REFERENCES Train (train_id);

ALTER TABLE TrainLocomotive
    ADD CONSTRAINT FK_TrainLocomotive_Loco
        FOREIGN KEY (loco_id) REFERENCES Locomotive (loco_id);

ALTER TABLE TrainWagon
    ADD CONSTRAINT FK_TrainWagon_Train
        FOREIGN KEY (train_id) REFERENCES Train (train_id);

ALTER TABLE TrainWagon
    ADD CONSTRAINT FK_TrainWagon_Wagon
        FOREIGN KEY (wagon_id) REFERENCES Wagon (wagon_id);

ALTER TABLE Wagon
    ADD CONSTRAINT FK_Wagon_Operator
        FOREIGN KEY (operator_id) REFERENCES Operator (operator_id);

ALTER TABLE Wagon
    ADD CONSTRAINT FK_Wagon_Model
        FOREIGN KEY (wagonmodel_id) REFERENCES WagonModel (wagonmodel_id);

ALTER TABLE WagonModel
    ADD CONSTRAINT FK_WagonModel_Type
        FOREIGN KEY (wagontype_id) REFERENCES WagonType (wagontype_id);

ALTER TABLE WagonModel
    ADD CONSTRAINT FK_WagonModel_Gauge
        FOREIGN KEY (gauge_id) REFERENCES Gauge (gauge_id);

ALTER TABLE RailwayLine
    ADD CONSTRAINT FK_RailwayLine_Owner
        FOREIGN KEY (owner_id) REFERENCES Owner (owner_id);

ALTER TABLE RailwayLine
    ADD CONSTRAINT FK_RailwayLine_Gauge
        FOREIGN KEY (gauge_id) REFERENCES Gauge (gauge_id);

ALTER TABLE RailwayLine
    ADD CONSTRAINT FK_RailwayLine_Start
        FOREIGN KEY (start_station_id) REFERENCES Facility (facility_id);

ALTER TABLE RailwayLine
    ADD CONSTRAINT FK_RailwayLine_End
        FOREIGN KEY (end_station_id) REFERENCES Facility (facility_id);

ALTER TABLE Electric_Locomotive
    ADD CONSTRAINT FK_ElectricLocomotive_Loco
        FOREIGN KEY (loco_id) REFERENCES Locomotive (loco_id);

ALTER TABLE Diesel_Locomotive
    ADD CONSTRAINT FK_DieselLocomotive_Loco
        FOREIGN KEY (loco_id) REFERENCES Locomotive (loco_id);

ALTER TABLE Facility
    ADD CONSTRAINT FK_Facility_Type
        FOREIGN KEY (facilitytype_id) REFERENCES FacilityType (facilitytype_id);

