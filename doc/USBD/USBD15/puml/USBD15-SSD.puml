@startuml USBD15-SSD
title SSD - USBD15: Number of Lines Departing from a Given Endpoint

actor PLANNER
participant "System" as APP
participant "SQL Database" as DB

activate PLANNER

PLANNER -> APP : request number of lines departing from endpoint(endpoint_name)
activate APP

APP -> DB : execute SQL query\n(count lines with given endpoint)
activate DB

DB --> APP : return total_lines
deactivate DB

APP --> PLANNER : display total number of lines departing\n(ex: "3 lines depart from Porto Campanhã")
deactivate APP

deactivate PLANNER
@enduml
