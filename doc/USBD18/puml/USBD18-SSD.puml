@startuml USBD18-SSD
title SSD - USBD18: Number of Segments in a Given Line by Track Type

actor PLANNER
participant "System" as APP
participant "SQL Database" as DB

activate PLANNER

PLANNER -> APP : request number of segments by track type (line_name)
activate APP

APP -> DB : execute SQL query\n(count segments per track type for the given line)
activate DB

DB --> APP : return result set (track_type, segment_count)
deactivate DB

APP --> PLANNER : display segment count by track type
deactivate APP

deactivate PLANNER
@enduml

