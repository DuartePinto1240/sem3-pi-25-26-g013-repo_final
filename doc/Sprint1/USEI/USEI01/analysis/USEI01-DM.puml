@startuml
' https://plantuml.com/class-diagram
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods
left to right direction

package "Warehouse Management" {

    class Warehouse {
        +warehouseId
        +aisles
    }

    class Aisle {
        +aisleId
        +bays
    }

    class Bay {
        +bayId
        +capacityBoxes
        +boxes
    }

    class Box {
        +boxId
        +SKU
        +qty
        +expiryDate
        +receivedAt
        +locationCode
    }

    class SKU {
        +skuCode
        +name
        +category
        +unit
        +volume
        +unitWeight
    }

    class Wagon {
        +wagonId
        +boxes
    }

    class WMS {
        +recordMovements()
        +trackStock()
    }

    class TerminalOperator {
        +executeUnloading()
        +dispatchStock()
        +relocateBox()
    }

}

' --- Relationships ---
Wagon "1" --> "0..*" Box : carries >
Box "*" --> "1" SKU : refers to >
Bay "1" --> "0..*" Box : stores >
Aisle "1" --> "1..*" Bay : contains >
Warehouse "1" --> "1..*" Aisle : includes >
TerminalOperator "1" --> "1" WMS : uses >
WMS "1" --> "1..*" Warehouse : manages >

' --- Behavioral notes ---
note right of Box
FEFO/FIFO rules:
1. expiryDate ASC (null last)
2. receivedAt ASC
3. boxId ASC
end note

note bottom of TerminalOperator
Unloading applies FEFO/FIFO sorting.
Dispatch consumes from front of bay list.
Relocation updates only warehouse/aisle/bay.
end note

@enduml
