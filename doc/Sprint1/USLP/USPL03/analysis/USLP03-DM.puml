@startuml
' https://plantuml.com/class-diagram
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods
left to right direction

package "Travel Time Estimation" {

    class Station {
        +stationId
        +name
        +location
    }

    class RailwayLine {
        +lineId
        +name
        +isElectrified
        +trackType         ' SINGLE | DOUBLE
    }

    class Locomotive {
        +locomotiveId
        +model
        +type              ' DIESEL | ELECTRIC | STEAM
        +maxSpeed
    }

    class TravelSection {
        +originStation
        +destinationStation
        +railwayLine
        +distanceKm
        +segmentMaxSpeed
    }

    class TravelTimeResult {
        +origin
        +destination
        +locomotiveModel
        +totalDistance
        +estimatedTime
        +sections
    }

    class TravelTimeCalculator {
        +calculateTravelTime(sections, locomotive)
    }

    class TrafficDispatcher {
        +selectStations()
        +selectLocomotive()
        +displayResult()
    }
}

' --- Relationships ---
TravelSection "*" --> "1" RailwayLine : belongs to >
TravelSection "1" --> "1" Station : origin >
TravelSection "1" --> "1" Station : destination >
TravelTimeResult "1" --> "1..*" TravelSection : includes >
TravelTimeCalculator "1" --> "1" TravelTimeResult : produces >
TravelTimeCalculator "1" --> "1" Locomotive : uses >
TrafficDispatcher "1" --> "1" TravelTimeCalculator : triggers >

' --- Behavioral notes ---
note right of TravelTimeCalculator
Travel time per section:
time(h) = distanceKm / effectiveSpeed
effectiveSpeed = min(segmentMaxSpeed, locomotive.maxSpeed)
Total time = Σ section times
Acceleration is assumed instantaneous.
end note

note right of TravelTimeResult
Stores:
- Origin/Destination
- Locomotive model/type
- Total distance
- Estimated time
- List of sections covered
end note

note bottom of TravelSection
Each section connects two directly linked stations.
Belongs to a RailwayLine, may be electrified or not.
end note

@enduml


