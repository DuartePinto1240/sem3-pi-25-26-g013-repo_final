@startuml
' https://plantuml.com/class-diagram
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods
left to right direction

package "Picking & Packing Management" {

    class PickingPlan {
        +planId
        +heuristicType    ' FF | FFD | BFD
        +trolleys
        +totalWeight
        +utilization
    }

    class Trolley {
        +trolleyId
        +capacityWeight
        +usedWeight
        +allocations
    }

    class Allocation {
        +orderId
        +lineNo
        +sku
        +qty
        +boxId
        +aisle
        +bay
        +weight
    }

    class SKU {
        +skuCode
        +name
        +unitWeight
        +category
    }

    class WarehousePlanner {
        +selectHeuristic()
        +createPickingPlan()
    }



}

' --- Relationships ---
PickingPlan "1" --> "1..*" Trolley : contains >
Trolley "1" --> "0..*" Allocation : holds >
Allocation "*" --> "1" SKU : refers to >
WarehousePlanner "1" --> "1" PickingPlan : manages >




note bottom of PickingPlan
Each plan fills trolleys up to their capacity.
If an allocation doesn't fit:
- Split between trolleys, or
- Defer to next trolley.
end note

note right of Trolley
utilization = usedWeight / capacityWeight
Example: 85% full
end note

@enduml



