@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Traffic Manager" as TM
participant ":USLP10UI" as UI
participant "controller:TrainDispatchSchedulerController" as CTRL
participant "service:TrainSchedulerService" as SERVICE
participant "repository:StationRepository" as ST_REPO
participant "repository:LocomotiveRepository" as LOCO_REPO
participant "repository:WagonRepository" as WAG_REPO
participant "repository:RailwayLineRepository" as LINE_REPO
participant "request:TrainDispatchRequest" as REQ
participant "schedule:TrainSchedule" as SCHED
participant "segment:ScheduledSegment" as SEG

activate TM

TM -> UI : run()
activate UI

' ==== carregar dados base ====
UI -> CTRL : getAvailableStations()
activate CTRL
CTRL -> ST_REPO : findAll()
activate ST_REPO
ST_REPO --> CTRL : List<Station>
deactivate ST_REPO
CTRL --> UI : List<Station>
deactivate CTRL

UI -> CTRL : getAvailableLocomotives()
activate CTRL
CTRL -> LOCO_REPO : findAll()
activate LOCO_REPO
LOCO_REPO --> CTRL : List<Locomotive>
deactivate LOCO_REPO
CTRL --> UI : List<Locomotive>
deactivate CTRL

UI -> CTRL : getAvailableWagons()
activate CTRL
CTRL -> WAG_REPO : findAll()
activate WAG_REPO
WAG_REPO --> CTRL : List<Wagon>
deactivate WAG_REPO
CTRL --> UI : List<Wagon>
deactivate CTRL

UI --> TM : display base data

' ==== configurar múltiplos comboios ====
loop para cada comboio
    TM -> UI : introduz trainId, rota, locomotives, wagons, departure
    UI -> CTRL : buildDispatchRequest(trainId, route, locomotives, wagons, departureTime)
    activate CTRL
    CTRL --> REQ : new TrainDispatchRequest(...)
    deactivate CTRL
    UI --> UI : adicionar REQ à lista de requests
end

' ==== agendar todos os comboios ====
UI -> CTRL : scheduleTrains(requests)
activate CTRL
CTRL -> SERVICE : scheduleTrains(requests)
activate SERVICE

loop para cada request em requests
    SERVICE -> SERVICE : scheduleSingleTrain(request, segmentsForTrain)
    activate SERVICE
    loop para cada par de estações consecutivas na rota
        SERVICE -> LINE_REPO : findDirectLine(from, to)
        activate LINE_REPO
        LINE_REPO --> SERVICE : RailwayLine
        deactivate LINE_REPO

        SERVICE -> "line:RailwayLine" : getSegments()
        activate "line:RailwayLine"
        "line:RailwayLine" --> SERVICE : List<LineSegment>
        deactivate "line:RailwayLine"

        loop para cada LineSegment
            SERVICE -> SERVICE : computeEffectiveSpeedKmH(...)
            SERVICE -> SEG : new ScheduledSegment(trainId, segment, entryTime, exitTime, directionAB)
            activate SEG
            SEG --> SERVICE : segment
            deactivate SEG

            SERVICE -> SCHED : addPassageTime(...)
        end
    end
    SERVICE --> SCHED : new TrainSchedule(trainId, route, departureTime)
deactivate SERVICE
end

' ==== detetar e resolver conflitos ====
SERVICE -> SERVICE : detectAndResolveConflicts(schedules, allSegments)
activate SERVICE
loop para cada par de segmentos single-track
    SERVICE -> SERVICE : verificar overlap(entry/exit)
    alt há conflito
        SERVICE -> SCHED : applyDelay(fromTime, delay)
        SERVICE -> SCHED : addCrossingOperation(locationName, otherTrainId, waitingTrainId, waitingDuration)
    end
end
deactivate SERVICE

SERVICE --> CTRL : schedules
deactivate SERVICE
CTRL --> UI : schedules
deactivate CTRL
UI --> TM : mostrar horários, cruzamentos e atrasos

deactivate UI
deactivate TM

@enduml