@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

' ===================== UI =====================
class USLP08UI {
  - controller: RoutePlannerController
  - scanner: Scanner
  --
  + USLP08UI()
  + run(): void
}

' ===================== Controller =====================
class RoutePlannerController {
  - repo: FreightRepository
  - service: RoutePlannerService
  --
  + getPendingFreights(): List<PendingFreightDTO>
  + autoPlanAll(): List<RoutePlanDTO>
  + planSelected(selectedIds: Set<Long>): List<RoutePlanDTO>
}

' ===================== Services =====================
class RoutePlannerService {
  + planRoutes(pending: List<PendingFreightDTO>): List<RoutePlanDTO>
}

' ===================== Repositories =====================
interface FreightRepository {
  + getPendingFreights(): List<PendingFreightDTO>
  + getCargosForFreight(freightId: long): List<CargoDTO>
}

class OracleFreightRepository {
  + getPendingFreights(): List<PendingFreightDTO>
  + getCargosForFreight(freightId: long): List<CargoDTO>
}

' ===================== DTO =====================
class PendingFreightDTO {
  - freightId: long
  - originFacilityId: long
  - destinationFacilityId: long
  - departTime: LocalDateTime
  - arrivalTime: LocalDateTime
}

class CargoDTO {
  - cargoId: long
  - wagonId: long
  - type: String
  - quantity: int
}

class RoutePlanDTO {}
class StopPlanDTO {}

' ===================== Relações =====================
USLP08UI --> RoutePlannerController
RoutePlannerController --> RoutePlannerService
RoutePlannerController --> FreightRepository

FreightRepository <|.. OracleFreightRepository

RoutePlannerService --> RoutePlanDTO
RoutePlannerService --> StopPlanDTO
RoutePlannerService --> PendingFreightDTO
RoutePlannerService --> CargoDTO

@enduml
