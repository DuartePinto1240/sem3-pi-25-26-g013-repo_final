@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Freight Manager" as FM
participant ":USLP07UI" as UI
participant "controller:TrainDispatchSchedulerController" as CTRL
participant "service:TrainSchedulerService" as SERVICE
participant "baseService:TrafficDispatcherService" as BASE
participant "stationRepo:StationRepository" as ST_REPO
participant "locoRepo:LocomotiveRepository" as LOCO_REPO
participant "wagonRepo:WagonRepository" as WAG_REPO
participant "lineRepo:RailwayLineRepository" as LINE_REPO
participant "request:TrainDispatchRequest" as REQ
participant "schedule:TrainSchedule" as SCHED
participant "segment:ScheduledSegment" as SEG

activate FM

FM -> UI : run()
activate UI

' ==== carregar dados base ====
UI -> CTRL : getAvailableStations()
activate CTRL
CTRL -> ST_REPO : findAll()
activate ST_REPO
ST_REPO --> CTRL : List<Station>
deactivate ST_REPO
CTRL --> UI : List<Station>
deactivate CTRL

UI -> CTRL : getAvailableLocomotives()
activate CTRL
CTRL -> LOCO_REPO : findAll()
activate LOCO_REPO
LOCO_REPO --> CTRL : List<Locomotive>
deactivate LOCO_REPO
CTRL --> UI : List<Locomotive>
deactivate CTRL

UI -> CTRL : getAvailableWagons()
activate CTRL
CTRL -> WAG_REPO : findAll()
activate WAG_REPO
WAG_REPO --> CTRL : List<Wagon>
deactivate WAG_REPO
CTRL --> UI : List<Wagon>
deactivate CTRL

UI --> FM : mostra listas de estações,\nlocomotivas e wagons

' ==== configurar N trains ====
loop para cada comboio
    FM -> UI : introduz ID, rota,\nlocomotivas, wagons,\npartida
    UI -> CTRL : buildDispatchRequest(trainId,\nroute, locomotives,\nwags, departureTime)
    activate CTRL
    CTRL --> REQ : new TrainDispatchRequest(...)
    deactivate CTRL
    UI --> UI : adiciona REQ à lista de pedidos
end

' ==== pedir ao sistema para agendar ====
UI -> CTRL : scheduleTrains(requests)
activate CTRL
CTRL -> SERVICE : scheduleTrains(requests)
activate SERVICE

' ==== agendar cada train individualmente ====
loop para cada request em requests
    SERVICE -> SERVICE : scheduleSingleTrain(request,\nsegmentsForTrain)
    activate SERVICE

        ' percorrer pares consecutivos de estações na rota
        loop para cada (from,to) na rota
            SERVICE -> LINE_REPO : findDirectLine(from, to)
            activate LINE_REPO
            LINE_REPO --> SERVICE : RailwayLine
            deactivate LINE_REPO

            SERVICE -> "line:RailwayLine" : getSegments()
            activate "line:RailwayLine"
            "line:RailwayLine" --> SERVICE : List<LineSegment>
            deactivate "line:RailwayLine"

            ' para cada segmento da linha
            loop para cada LineSegment
                SERVICE -> SERVICE : computeEffectiveSpeedKmH(...)

                SERVICE -> SEG : new ScheduledSegment(\ntrainId, segment,\nentryTime, exitTime, directionAB)
                activate SEG
                SEG --> SERVICE : segment
                deactivate SEG

                SERVICE -> SCHED : addPassageTime(...)
            end
        end

        SERVICE --> SCHED : new TrainSchedule(trainId,\nroute, departureTime)
    deactivate SERVICE
end

' ==== detetar cruzamentos em single-track ====
SERVICE -> SERVICE : detectAndResolveConflicts(\nschedules, allSegments)
activate SERVICE
    ' para cada par de ScheduledSegment em linhas single-track
    loop para cada par de segmentos em single-track
        SERVICE -> SERVICE : verificar overlap(entry/exit)
        alt há conflito
            SERVICE -> SCHED : applyDelay(fromTime, delay)
            SERVICE -> SCHED : addCrossingOperation(\nlocationName, otherTrainId,\nwaitingTrainId, waitingDuration)
        end
    end
deactivate SERVICE

SERVICE --> CTRL : schedules
deactivate SERVICE

CTRL --> UI : schedules
deactivate CTRL

UI --> FM : mostra horários,\ncruzamentos e atrasos
deactivate UI
deactivate FM

@enduml
