@startuml USBD29-SSD
title SSD - USBD29: Get the Percentage of Electric Locomotives per Operator

actor PLANNER
participant "System" as APP
participant "SQL Database" as DB

activate PLANNER

PLANNER -> APP : request percentage of electric locomotives\nfor a given operator (operatorName)
activate APP

APP -> DB : execute PL/SQL function\n(get_electric_percentage(operatorName))
activate DB

DB --> APP : return SYS_REFCURSOR result\n(operatorName, totalLocomotives, electricLocomotives, percentage)
deactivate DB

APP --> PLANNER : display electric locomotive percentage\nfor the requested operator
deactivate APP

deactivate PLANNER
@enduml
