@startuml USBD26-SSD
title SSD - USBD26: Wagons Not Used in Any Train in a Given Period

actor PLANNER
participant "System" as APP
participant "SQL Database" as DB

activate PLANNER

PLANNER -> APP : request list of unused wagons\n(startDate, endDate)
activate APP

APP -> DB : execute SQL query\n(find wagons not assigned to any train\nwithin the given period)
activate DB

DB --> APP : return result set (wagonId, type, operator, gauge)
deactivate DB

APP --> PLANNER : display list of unused wagons
deactivate APP

deactivate PLANNER
@enduml
